# BidSahayak Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key
LLM_API_KEY=your-api-key-here

# Server & Security
HOST=0.0.0.0
# Allowed CORS origins (* for public online hosting, or comma-separated domains)
ALLOWED_ORIGINS=*

# Max file size in MB
MAX_PDF_SIZE_MB=25

# Max pages per PDF
MAX_PDF_PAGES=400

# Confidence threshold for human review gating
CONFIDENCE_THRESHOLD=0.7
