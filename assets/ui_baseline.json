  "--card-tint": "rgba(202,166,102,.10)",
  "--sans": "'Archivo','Noto Sans Devanagari',system-ui,-apple-system,sans-serif",
  "--mono": "'IBM Plex Mono','Noto Sans Devanagari',ui-monospace,monospace",
